# Copy this to a local file such as .env.benchmark and fill in the values.
# Then run:
#   ENV_FILE=.env.benchmark ./run_all.sh

# Provider/API keys
RELAY_KIMI_KEY=
RELAY_MINIMAX_KEY=
RELAY_GLM_KEY=
RELAY_CLAUDE_KEY=
RELAY_GPT54_KEY=
RELAY_GPT54_MINI_KEY=
GOOGLE_GEMINI_API_KEY=
ZAI_API_KEY=
MINIMAX_API_KEY=

# Core benchmark runner configuration
SHOWBOAT_BIN=
MODELS_FILE=config/models.json
HOST_CONFIG=config/hosts.json
CASE_WORKSPACES_DIR=case-workspaces
OPENCODE_BIN=
OPENCODE_RUNNER_TEMPLATE=
CLAUDE_RUNNER_TEMPLATE=
TIMEOUT=300
PRINT_LIVE=0
ONLY_MODELS=
SKIP_EXISTING=0

# Output execution / audit artifacts
EXECUTE_OUTPUTS=0
EXECUTE_TIMEOUT=60

# Post-run effectiveness summary hook
ENABLE_EFFECTIVENESS_SUMMARY=0
EFFECTIVENESS_DATASET=dataset.json
EFFECTIVENESS_REPORTS_DIR=reports
EFFECTIVENESS_OUTPUTS_GLOB=outputs-*.json
EFFECTIVENESS_SKILL_PATH=skills/final-effectiveness-summary
EFFECTIVENESS_ARTIFACTS_DIR=artifacts/effectiveness-summary
EFFECTIVENESS_OUTPUT_MARKDOWN=reports/final-effectiveness-summary.md
EFFECTIVENESS_TIMEOUT=300

# Judge invocation for effectiveness summary
EFFECTIVENESS_INVOKE_JUDGE=0
EFFECTIVENESS_REVIEW_MODEL=relay-kimi/kimi-k2.5
EFFECTIVENESS_REVIEW_RUNNER=opencode run --model {model} --format json
